<?xml version="1.0" encoding="utf-8"?>

<network-security-config>

    <!-- ── Serveur LAN CAP-EPAC ─────────────────────────────── -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">192.168.10.150</domain>
        <domain includeSubdomains="true">cap-epac.local</domain>
        <domain includeSubdomains="true">*.cap-epac.local</domain>

        <!-- Accepter notre CA mkcert locale + CA système -->
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="@raw/cap_epac_ca"/>
        </trust-anchors>
    </domain-config>

    <!-- ── Localhost Metro bundler (debug uniquement) ─────────── -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>

    <!-- ── Politique de base (tout le reste) ─────────────────── -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

</network-security-config>